{"block": 1, "code": "def encode_amount(dollars: str) -> str:\n    s = dollars.strip()\n    sign = '+'\n    if s.startswith('-'):\n        sign = '-'\n        s = s[1:]\n    elif s.startswith('+'):\n        s = s[1:]\n\n    if '.' in s:\n        int_part, frac_part = s.split('.', 1)\n    else:\n        int_part, frac_part = s, ''\n\n    # Normalize fractional part to exactly 2 digits (cents)\n    frac_part = (frac_part + '00')[:2]\n\n    int_part = int_part or '0'\n\n    minor = int(int_part) * 100 + int(frac_part)\n\n    digits = str(minor)\n\n    check = sum(int(c) for c in digits) % 10\n\n    return f\"{sign}{digits}#{check}\"\n", "condition": "W2", "graded_utc": "2026-10-01T07:56:14.186+00:00", "model": "Opus-4.8", "pass_current": true, "pass_published": true, "schedule_id": "smoke|Opus-4.8|enc_amount|001|W2", "task": "enc_amount", "type": "grade", "window": "smoke"}
