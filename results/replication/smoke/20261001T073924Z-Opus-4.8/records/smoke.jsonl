{"block": 1, "code": "def encode_amount(dollars: str) -> str:\n    dollars = dollars.strip()\n    sign = '+'\n    if dollars.startswith('-'):\n        sign = '-'\n        dollars = dollars[1:]\n    elif dollars.startswith('+'):\n        dollars = dollars[1:]\n\n    if '.' in dollars:\n        int_part, frac_part = dollars.split('.', 1)\n    else:\n        int_part, frac_part = dollars, ''\n\n    # Normalize fractional part to exactly 2 digits (cents)\n    frac_part = (frac_part + '00')[:2]\n\n    int_part = int_part or '0'\n\n    cents = int(int_part) * 100 + int(frac_part)\n    digits = str(cents)\n\n    check = sum(int(d) for d in digits) % 10\n\n    return f\"{sign}{digits}#{check}\"\n", "condition": "W2", "graded_utc": "2026-10-01T07:39:51.397+00:00", "model": "Opus-4.8", "pass_current": true, "pass_published": true, "schedule_id": "smoke|Opus-4.8|enc_amount|001|W2", "task": "enc_amount", "type": "grade", "window": "smoke"}
