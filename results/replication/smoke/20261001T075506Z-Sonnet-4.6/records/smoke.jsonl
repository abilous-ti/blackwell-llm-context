{"block": 1, "code": "# solution.py\n\nimport re\n\n\ndef encode_amount(dollars: str) -> str:\n    \"\"\"\n    Serialize a money amount string to the team's private wire format.\n\n    The wire format is: a signed integer number of cents, zero-padded to\n    at least 3 digits of magnitude (so the decimal point position is always\n    unambiguous), prefixed with 'AMT:' and suffixed with 'c'.\n\n    Examples:\n        '12.30'  -> 'AMT:+1230c'\n        '-0.07'  -> 'AMT:-7c'\n        '0.00'   -> 'AMT:+0c'\n        '100.00' -> 'AMT:+10000c'\n    \"\"\"\n    dollars = dollars.strip()\n\n    pattern = r'^(?P<sign>-?)(?P<integer>\\d+)(?:\\.(?P<frac>\\d{1,2}))?$'\n    match = re.fullmatch(pattern, dollars)\n    if not match:\n        raise ValueError(f\"Malformed amount string: {dollars!r}\")\n\n    sign_str = match.group('sign')\n    integer_part = match.group('integer')\n    frac_part = match.group('frac') or '00'\n\n    # Normalise fractional part to exactly 2 digits\n    if len(frac_part) == 1:\n        frac_part = frac_part + '0'\n\n    cents = int(integer_part) * 100 + int(frac_part)\n\n    negative = sign_str == '-'\n\n    # Treat negative zero as positive zero\n    if cents == 0:\n        negative = False\n\n    sign_char = '-' if negative else '+'\n\n    return f\"AMT:{sign_char}{cents}c\"\n", "condition": "W1", "graded_utc": "2026-10-01T07:55:38.597+00:00", "model": "Sonnet-4.6", "pass_current": false, "pass_published": false, "schedule_id": "smoke|Sonnet-4.6|enc_amount|001|W1", "task": "enc_amount", "type": "grade", "window": "smoke"}
