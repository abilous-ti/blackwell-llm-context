{"block": 1, "code": "def encode_amount(dollars: str) -> str:\n    # Determine sign\n    s = dollars.strip()\n    if s.startswith('-'):\n        sign = '-'\n        s = s[1:]\n    elif s.startswith('+'):\n        sign = '+'\n        s = s[1:]\n    else:\n        sign = '+'\n\n    # Parse dollars string into minor units (cents)\n    if '.' in s:\n        integer_part, frac_part = s.split('.', 1)\n        # Pad or truncate fractional part to 2 digits\n        frac_part = (frac_part + '00')[:2]\n    else:\n        integer_part = s\n        frac_part = '00'\n\n    integer_part = integer_part.lstrip('0') or '0'\n    minor_units = int(integer_part) * 100 + int(frac_part)\n\n    digits = str(minor_units)\n\n    # Compute check digit: sum of decimal digits in digits, mod 10\n    check = sum(int(d) for d in digits) % 10\n\n    return f\"{sign}{digits}#{check}\"\n", "condition": "W2", "graded_utc": "2026-10-01T07:55:43.956+00:00", "model": "Sonnet-4.6", "pass_current": true, "pass_published": true, "schedule_id": "smoke|Sonnet-4.6|enc_amount|001|W2", "task": "enc_amount", "type": "grade", "window": "smoke"}
